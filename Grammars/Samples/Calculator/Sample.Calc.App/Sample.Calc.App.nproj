<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NemerleVersion>Net-4.0</NemerleVersion>
    <NemerleBinPathRoot Condition=" '$(NemerleBinPathRoot)' == '' ">$(ProgramFiles)\Nemerle</NemerleBinPathRoot>
    <NoStdLib>true</NoStdLib>
    <Nemerle Condition=" '$(Nemerle)' == '' ">$(NemerleBinPathRoot)\$(NemerleVersion)</Nemerle>
    <Name>Sample.Calc.App</Name>
    <DocumentationFile />
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProductVersion>8.0.30703</ProductVersion>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{2d7f5411-0e9d-4230-955b-1cda9dfa8512}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Sample.Calc.App</RootNamespace>
    <AssemblyName>Sample.Calc.App</AssemblyName>
    <!--Core exe: netstandard20 cannot host a runnable app (no apphost/runtimeconfig). Shape taken
        from the toolchain's own Core-built exe (nemerle\ncc.nproj): net10.0 + no refint assembly.-->
    <TargetFramework>net10.0</TargetFramework>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <FileAlignment>512</FileAlignment>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\..\</SolutionDir>
    <RestorePackages>true</RestorePackages>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <RunDebugger>false</RunDebugger>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <DocumentationFile>$(OutputPath)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.props" />
  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="System" />
    <Reference Include="System.Core">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference>
    <Reference Include="Nemerle">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(Nemerle)\Nemerle.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Main.n" />
    <Compile Include="Properties\AssemblyInfo.n" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Nitra\Nitra.Runtime\Nitra.Runtime.nproj">
      <Name>Nitra.Runtime</Name>
      <Project>{9db13eb2-28e3-432b-8c8f-0e39ef5bcc38}</Project>
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="..\Sample.Calc\Sample.Calc.nproj">
      <Name>Sample.Calc</Name>
      <Project>{7bbcb70e-df4a-4353-b8c0-66789fa75cba}</Project>
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="..\Sample.Num\Sample.Num.nproj">
      <Name>Sample.Num</Name>
      <Project>{e78897be-4601-4707-a6ce-498b9b805f99}</Project>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <!--The net10.0 targeting pack contributes System.Collections.Immutable, whose types duplicate the
      ones of System.Collections.Immutable.Light (the assembly Nitra.Runtime is built against and
      what its API surface exposes), and ncc ICEs on that clash: "not loaded internal type...
      System.Collections.Immutable.ImmutableList`1+Builder, System.Collections.Immutable.Light".
      Drop the targeting-pack copy from the compile reference set for this project (the Light one is
      kept; nothing in the App touches the real System.Collections.Immutable).-->
  <Target Name="ExcludeTargetingPackImmutableCollections" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath->WithMetadataValue('Filename', 'System.Collections.Immutable'))" />
    </ItemGroup>
  </Target>
  <Import Project="$(Nemerle)\Nemerle.Sdk.targets" />
</Project>
