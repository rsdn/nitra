<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WpfHint2</AssemblyName>
    <RootNamespace>WpfHint2</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Key.snk</AssemblyOriginatorKeyFile>
    <!-- Сохраняем плоский выход bin\$(Configuration)\ без TFM-подпапки: на него смотрят
         consumer-csproj через HintPath ..\..\WpfHint\bin\$(Configuration)\WpfHint2.dll. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Остальные ссылки (System, System.Core, System.Xml, System.Xml.Linq, WindowsBase,
         PresentationCore, PresentationFramework, System.Xaml) подставляют SDK и UseWPF. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
